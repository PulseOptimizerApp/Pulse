<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pulse.Ui"
        Title="Pulse Optimizer" Icon="app.ico" Width="1200" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ambient glow behind content -->
        <Ellipse x:Name="Glow" Grid.Column="1" Grid.RowSpan="2" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-300,-200,0" Fill="{StaticResource GlowBrush}" IsHitTestVisible="False" Opacity="0.6"/>

        <!-- ═════════ Sidebar ═════════ -->
        <Border Grid.RowSpan="2" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,10,0,0">
                    <!-- Pulse logo (assets/icon.svg rendered at 128 px) -->
                    <Image Source="/Assets/logo-128.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pulse" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="EVIDENCE-BASED OPTIMIZER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Border x:Name="NavHighlight" Height="40" VerticalAlignment="Top" CornerRadius="10" Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False">
                        <Border.RenderTransform><TranslateTransform x:Name="NavHighlightT"/></Border.RenderTransform>
                        <Border Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AccentGradientV}"/>
                    </Border>
                    <StackPanel x:Name="NavPanel">
                        <RadioButton Style="{StaticResource NavButton}" Tag="home" ui:Icon.Glyph="&#xE80F;" Content="Home" IsChecked="True" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="games" ui:Icon.Glyph="&#xE7FC;" Content="Games" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="clips" ui:Icon.Glyph="&#xE714;" Content="Clips" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="roblox" ui:Icon.Glyph="&#xE768;" Content="Roblox" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="diagnose" ui:Icon.Glyph="&#xE9D9;" Content="Diagnose" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="tweaks" ui:Icon.Glyph="&#xE945;" Content="Tweaks" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="cleanup" ui:Icon.Glyph="&#xE74D;" Content="Debloat" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="fresh" ui:Icon.Glyph="&#xE895;" Content="Keep it fresh" Checked="Nav_Checked" Click="Nav_Click"/>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="10,10,10,10"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="measure" ui:Icon.Glyph="&#xE9D2;" Content="Measure" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="reaction" ui:Icon.Glyph="&#xE916;" Content="Reaction trainer" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="macros" ui:Icon.Glyph="&#xE962;" Content="Click macro" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="startup" ui:Icon.Glyph="&#xE7E8;" Content="Startup apps" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="security" ui:Icon.Glyph="&#xEA18;" Content="Security" Checked="Nav_Checked" Click="Nav_Click"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="safety" ui:Icon.Glyph="&#xE7A7;" Content="Undo &amp; restore" Checked="Nav_Checked" Click="Nav_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Live mini stats (and what Clips is doing) -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <Border x:Name="ClipsPill" CornerRadius="10" Padding="10,8" Margin="0,0,0,12" Background="#1434D399" BorderBrush="#4034D399" BorderThickness="1"
                                Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ClipsPill_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center">
                                    <Ellipse.Effect><DropShadowEffect Color="#34D399" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                </Ellipse>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Clips is recording" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock x:Name="ClipsPillGame" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock x:Name="MiniCpu" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="4"><Border Style="{StaticResource BarTrack}" Height="4"/><Border x:Name="MiniCpuBar" Style="{StaticResource BarFill}" Height="4"/></Grid>
                        <Grid Margin="0,10,0,8">
                            <TextBlock Text="GPU" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock x:Name="MiniGpu" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="4"><Border Style="{StaticResource BarTrack}" Height="4"/><Border x:Name="MiniGpuBar" Style="{StaticResource BarFill}" Height="4"/></Grid>
                        <Grid Margin="0,10,0,8">
                            <TextBlock Text="Memory" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock x:Name="MiniRam" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="4"><Border Style="{StaticResource BarTrack}" Height="4"/><Border x:Name="MiniRamBar" Style="{StaticResource BarFill}" Height="4"/></Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════ Top bar chip ═════════ -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,156,0">
        <Grid Margin="0,0,8,0">
            <Button x:Name="LangBtn" Style="{StaticResource GhostButton}" Padding="10,4,10,5" FontSize="12" Click="Lang_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Language">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LangLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="EN"/>
                </StackPanel>
            </Button>
            <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangBtn}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="190">
                    <StackPanel x:Name="LangList"/>
                </Border>
            </Popup>
        </Grid>
        <Border CornerRadius="13" Padding="10,4,12,5"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Text, ElementName=SidebarStatus}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource GoodBrush}"/>
                <TextBlock Text="Every change can be undone" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock x:Name="SidebarStatus" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- ═════════ Caption buttons ═════════ -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <!-- ═════════ Page host ═════════ -->
        <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
            <ContentControl x:Name="PageHost" Margin="36,0,36,0" Focusable="False">
                <ContentControl.RenderTransform><TranslateTransform x:Name="PageHostT"/></ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ═════════ Toast ═════════ -->
        <Border x:Name="ToastBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                CornerRadius="12" Padding="16,11" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastT" Y="24"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Style="{StaticResource IconText}" FontSize="14"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═════════ New version ═════════ -->
        <Border x:Name="UpdateBar" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
                Style="{StaticResource HeroCard}" Background="{StaticResource Surface2Brush}" Padding="18,14" MaxWidth="440" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.5" Color="Black"/></Border.Effect>
            <StackPanel>
                <TextBlock x:Name="UpdateTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="UpdateText" Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Your settings and clips stay as they are. Pulse restarts by itself in a few seconds."/>
                <Grid x:Name="UpdateProgress" Height="8" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border Style="{StaticResource BarTrack}" Height="8"/>
                    <Border x:Name="UpdateFill" Style="{StaticResource BarFill}" Height="8" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Content="Install now" Click="Update_Click"/>
                    <Button x:Name="UpdateLaterBtn" Style="{StaticResource GhostButton}" Content="Later" Margin="10,0,0,0" Click="UpdateLater_Click"/>
                    <Button x:Name="UpdateCancelBtn" Style="{StaticResource GhostButton}" Content="Cancel" Margin="10,0,0,0" Click="UpdateCancel_Click" Visibility="Collapsed"/>
                    <Button x:Name="UpdateSkipBtn" Style="{StaticResource LinkButton}" Content="Skip this version" Margin="14,0,0,0" VerticalAlignment="Center" Click="UpdateSkip_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═════════ Dialog overlay ═════════ -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" Background="#A6050811">
            <Border x:Name="DialogCard" Width="480" Style="{StaticResource Card}" Padding="28,24" Background="{StaticResource Surface2Brush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/></Border.Effect>
                <StackPanel>
                    <!-- Big working / done icon for the step-by-step screen -->
                    <Grid x:Name="DialogStepIcon" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed">
                        <Ellipse Fill="{StaticResource InfoSoftBrush}"/>
                        <ui:Spinner x:Name="DialogStepSpinner" Width="64" Height="64" Thickness="4" Brush="{StaticResource AccentGradient}"/>
                        <TextBlock x:Name="DialogStepGlyph" Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                    <!-- Step-by-step progress -->
                    <StackPanel x:Name="DialogSteps" Margin="0,18,0,0" Visibility="Collapsed">
                        <Grid>
                            <Border Style="{StaticResource BarTrack}" Height="6"/>
                            <Border x:Name="DialogStepBar" Style="{StaticResource BarFill}" Height="6" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <!-- Percent done and time left, so a long step never looks frozen -->
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="DialogStepEta" Style="{StaticResource Sub}" FontSize="12"/>
                            <TextBlock x:Name="DialogStepPct" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl x:Name="DialogStepList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1.5" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}"/>
                                            <ui:Spinner Width="18" Height="18" Thickness="2" Brush="{StaticResource AccentGradient}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Fill="{StaticResource GoodSoftBrush}"/>
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Fill="{StaticResource WarnSoftBrush}"/>
                                                <TextBlock Text="&#xE738;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="DialogStepStop" Style="{StaticResource LinkButton}" Content="Stop after this item" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="DialogStepStop_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="DialogBusyRow" Orientation="Horizontal" Margin="0,20,0,0" Visibility="Collapsed">
                        <ui:Spinner Width="22" Height="22" Brush="{StaticResource AccentGradient}"/>
                        <TextBlock x:Name="DialogBusyText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Text="Working…"/>
                    </StackPanel>
                    <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource GhostButton}" Click="DialogCancel_Click" Margin="0,0,10,0" Content="Cancel"/>
                        <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Click="DialogOk_Click" Content="Continue"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
