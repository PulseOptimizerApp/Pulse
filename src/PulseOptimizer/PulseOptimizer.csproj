<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>PulseOptimizer</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>

    <!-- File properties shown in Windows (right-click > Properties > Details). -->
    <Product>Pulse Optimizer</Product>
    <AssemblyTitle>Pulse Optimizer</AssemblyTitle>
    <Description>Open-source gaming PC companion. Not affiliated with Microsoft or Intel.</Description>
    <Company>Pulse Optimizer (open source)</Company>
    <Copyright>AGPL-3.0-or-later</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Less JIT bookkeeping in memory. (No GC "conserve memory": its extra compacting pauses make recordings drop frames.) -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\logo-128.png" />
    <!-- Game covers fetched by tools/get-game-art.py at build time (not committed). -->
    <Resource Include="Assets\Games\*.jpg" />
    <!-- Translations: English text → translated text, one file per language. -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <EmbeddedResource Include="Core\Guide\guide.json" LogicalName="guide.json" />
    <!-- Mouse drivers: OpenMouse mouse-protocol (AGPL-3.0-or-later), built by CI from drivers/ -->
    <EmbeddedResource Include="Assets\Drivers\mouse-drivers.js" LogicalName="mouse-drivers.js" Condition="Exists('Assets\Drivers\mouse-drivers.js')" />
    <Resource Include="Assets\Games\*.png" />
    <!-- VALORANT agent, map and rank art for match recaps, fetched by tools/get-match-art.py at build time (not committed). -->
    <Resource Include="Assets\Matches\*.png" />
    <Resource Include="Assets\Matches\*.jpg" />
    <Resource Include="Assets\Matches\meta.json" Condition="Exists('Assets\Matches\meta.json')" />
    <!-- PresentMon (Intel, MIT) is downloaded here by the build and carried inside the exe, so the release is one file. -->
    <EmbeddedResource Include="tools\PresentMon.exe" Condition="Exists('tools\PresentMon.exe')" LogicalName="PresentMon.exe" />
    <!-- SHA-256 of the FFmpeg zip attached to this release (tools/get-ffmpeg.ps1). Clips refuses any other file. -->
    <EmbeddedResource Include="tools\ffmpeg.sha256" Condition="Exists('tools\ffmpeg.sha256')" LogicalName="ffmpeg.sha256" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseOptimizer.Tests" />
  </ItemGroup>

</Project>
