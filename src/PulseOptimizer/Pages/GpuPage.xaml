<UserControl x:Class="Pulse.Pages.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="GPU tuning"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Watch your graphics card live, and tune its power, clocks and voltage, like MSI Afterburner, built into Pulse."/>
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Root" Margin="0,0,8,32"/>
        </ScrollViewer>
    </Grid>
</UserControl>
