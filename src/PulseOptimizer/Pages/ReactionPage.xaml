<UserControl x:Class="Pulse.Pages.ReactionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui"
             Focusable="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,40">
            <TextBlock Style="{StaticResource H1}" Text="Reaction trainer"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Drills built like the game: enemies peeking from angles, teammates you mustn't shoot, and holding your crosshair where heads appear. They adapt to keep you at about 80% right, the level where practice actually makes you faster. Five minutes a day beats one long session."/>

            <!-- Daily plan and weekly Benchmark -->
            <Border x:Name="PlanCard" Style="{StaticResource Card}" Margin="0,20,0,0" ui:Anim.Reveal="True">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Today's training"/>
                            <TextBlock x:Name="StreakText" FontSize="12" FontWeight="SemiBold" Foreground="#FFB547" Margin="10,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <WrapPanel x:Name="PlanSteps" Margin="0,10,0,0"/>
                        <TextBlock x:Name="BenchText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="PlanButton" Style="{StaticResource PrimaryButton}" Content="Start (about 5 min)" Click="StartPlan_Click"/>
                        <Button x:Name="BenchButton" Style="{StaticResource GhostButton}" Content="Take the Benchmark" Margin="0,8,0,0" Click="Benchmark_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drill picker -->
            <WrapPanel x:Name="ModeChips" Margin="0,22,0,0"/>
            <TextBlock x:Name="ModeText" Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left"/>

            <!-- In-game sensitivity: the crosshair moves like VALORANT (for the mouse drills) -->
            <Border x:Name="FeelRow" Margin="0,14,0,0" Padding="14,10,14,10" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="FeelSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Feel_Changed"/>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Move like VALORANT" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FeelText" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sensitivity" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SensBox" Style="{StaticResource SearchBox}" Width="70" LostKeyboardFocus="Feel_Changed" KeyDown="FeelBox_KeyDown"/>
                        <TextBlock Text="DPI" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <TextBox x:Name="DpiBox" Style="{StaticResource SearchBox}" Width="70" LostKeyboardFocus="Feel_Changed" KeyDown="FeelBox_KeyDown"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The arena: click anywhere in it (or press Space, or A / D in Left or right) -->
            <Border x:Name="Arena" Margin="0,18,0,0" Height="430" CornerRadius="16" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    MouseLeftButtonDown="Arena_MouseDown" ui:Anim.Reveal="True">
                <Grid>
                    <Border x:Name="Glow" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55F2EFE8" Offset="0"/>
                                <GradientStop Color="#55F2EFE8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="Sides" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="LeftSide" CornerRadius="16,0,0,16"/>
                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>
                        <Border x:Name="RightSide" Grid.Column="2" CornerRadius="0,16,16,0"/>
                    </Grid>
                    <Canvas x:Name="Field" IsHitTestVisible="False"/>
                    <Canvas x:Name="CrossLayer" IsHitTestVisible="False"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="BigText" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Text="Click to start"/>
                        <TextBlock x:Name="SmallText" FontSize="14" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="18,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Results -->
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed" ui:Anim.Reveal="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="You" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock x:Name="MedianText" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentGradient}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="32,6,0,0" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,32,8"><TextBlock Text="Best" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="BestText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Margin="0,0,32,8"><TextBlock Text="Consistency" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="SpreadText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Margin="0,0,32,8"><TextBlock Text="Mistakes" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="MistakeText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel x:Name="LevelBox" Margin="0,0,32,8"><TextBlock Text="Level reached" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="LevelText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel x:Name="AccuracyBox" Margin="0,0,32,8"><TextBlock Text="Enemies hit" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="AccuracyText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel x:Name="HeadBox" Margin="0,0,32,8"><TextBlock Text="Headshots" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="HeadText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel x:Name="OffsetBox" Margin="0,0,32,8"><TextBlock Text="Crosshair off by" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="OffsetText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        </WrapPanel>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Go again" VerticalAlignment="Center" Click="Again_Click"/>
                    </Grid>
                    <!-- Where the time went: you vs your PC, mouse and screen -->
                    <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Height="10" Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="YouCol" Width="9*"/><ColumnDefinition x:Name="PcCol" Width="1*"/></Grid.ColumnDefinitions>
                                <Border CornerRadius="5,0,0,5" Background="{StaticResource AccentGradient}"/>
                                <Border Grid.Column="1" CornerRadius="0,5,5,0" Background="#5A6072"/>
                            </Grid>
                            <TextBlock x:Name="SplitText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SplitDetail" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CompareText" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- You on the curve of how fast people are -->
            <Border x:Name="PopCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed" ui:Anim.Reveal="True">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="How you compare"/>
                            <TextBlock x:Name="PopText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="PopPct" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PopTier" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <Canvas x:Name="PopChart" Height="190" Margin="0,14,0,0" ClipToBounds="False" SizeChanged="PopChart_SizeChanged"/>
                </StackPanel>
            </Border>

            <!-- Progress over time -->
            <Border x:Name="HistoryCard" Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="Collapsed" ui:Anim.Reveal="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Your progress"/>
                    <TextBlock x:Name="HistoryText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,12"/>
                    <Canvas x:Name="Chart" Height="150" ClipToBounds="True"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,20,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Pure reaction time (the plain Reaction drill) only improves a little with practice: it's mostly how your nerves are built. What improves a lot is everything around it in a real fight: spotting, deciding, and having your crosshair already where the head appears. The game drills train those, and the Benchmark, which never changes difficulty, shows whether it's working. The delay from your PC, mouse and screen is an estimate from your screen's refresh rate, assuming a 1000 Hz gaming mouse; compare sessions on the same setup."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
