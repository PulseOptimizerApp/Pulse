<UserControl x:Class="Pulse.Pages.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Your mice, with battery -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,14,10,12" Margin="0,0,20,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,0,4,10">
                    <TextBlock Text="YOUR MICE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" ToolTip="Scan again" Click="Refresh_Click">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12"/>
                    </Button>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Click="AllMice_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0E2;" Style="{StaticResource IconText}" FontSize="12"/>
                            <TextBlock Text="All mice" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0" Content="Keyboard and audio" Click="Other_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MouseList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Main" Margin="0,0,8,32"/>
        </ScrollViewer>
    </Grid>
</UserControl>
