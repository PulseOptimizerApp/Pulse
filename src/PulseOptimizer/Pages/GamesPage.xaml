<UserControl x:Class="Pulse.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <Grid Margin="0,6,0,0">
        <!-- ═════════ Library ═════════ -->
        <ScrollViewer x:Name="LibraryView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,6,0,40">
                <TextBlock Style="{StaticResource H1}" Text="Games"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                           Text="Pick a game for a checklist built for your graphics card and monitor: lower delay, more FPS, and a before-and-after check."/>
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="0,22,0,0">
                    <ui:Spinner Width="20" Height="20" Brush="{StaticResource AccentGradient}"/>
                    <TextBlock Text="Finding your games…" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <!-- While you play: works for every game -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,18" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="While you play"/>
                        <Grid Style="{StaticResource Row}" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Game mode"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="620"
                                           Text="High performance power plan while a game runs, your usual one when it closes. Helps most on laptops."/>
                            </StackPanel>
                            <CheckBox x:Name="GameModeSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Session_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Performance overlay"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="560"
                                           Text="FPS, 1% low, a frame time graph, CPU and GPU load, GPU temperature and memory in a corner while you play. Ctrl+Shift+O hides it. Shows over borderless and windowed games and never touches the game."/>
                            </StackPanel>
                            <WrapPanel x:Name="CornerChips" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0"/>
                            <CheckBox x:Name="OverlaySwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Session_Click"/>
                        </Grid>
                        <Border x:Name="OverlayOptions" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="16,14" Margin="0,4,0,10" Visibility="Collapsed"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Lag check"/>
                                <TextBlock x:Name="NetText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Is lag coming from your PC and Wi-Fi, or from your internet? Pings your router and a stable internet address for a few seconds."/>
                                <TextBlock x:Name="NetDetail" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="NetBtn" Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Content="Check my connection" Click="Net_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Stutter detective"/>
                                <TextBlock x:Name="StutterText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Start a game and play normally. Pulse watches for 30 seconds, finds the stutters and tells you what's most likely causing them."/>
                                <TextBlock x:Name="StutterDetail" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="620"/>
                            </StackPanel>
                            <Button x:Name="StutterBtn" Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Content="Find my stutters" Click="Stutter_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H2}" Text="Your games" Margin="0,22,0,0"/>
                <ItemsControl x:Name="GameGrid" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Style="{StaticResource GameTile}" Click="Tile_Click" ui:Anim.Reveal="True"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" CornerRadius="6" Padding="6,2,6,3" Background="#CC0B0C10"
                                        Visibility="{Binding ProgressText, Converter={StaticResource HasValueToVis}}" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="White" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Supported games that aren't on this PC -->
                <Grid x:Name="OtherHeader" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="More games Pulse has checklists for"/>
                        <TextBlock x:Name="OtherCount" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="OtherToggle" Style="{StaticResource LinkToggle}" Content="Show" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OtherToggle_Click"/>
                </Grid>
                                <ItemsControl x:Name="OtherGrid" Visibility="Collapsed" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Style="{StaticResource GameTile}" Click="Tile_Click" ui:Anim.Reveal="True"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" CornerRadius="6" Padding="6,2,6,3" Background="#CC0B0C10"
                                        Visibility="{Binding ProgressText, Converter={StaticResource HasValueToVis}}" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="White" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Suggestions -->
                <TextBlock Style="{StaticResource H2}" Text="Find something new" Margin="0,28,0,12"/>
                <TextBlock x:Name="SuggestBecause" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="GenreChips"/>
                <ItemsControl x:Name="SuggestList" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Margin="0,0,10,10" Padding="18,14" ui:Anim.Reveal="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="74" VerticalAlignment="Top">
                                        <Border CornerRadius="8" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="8" ClipToBounds="True" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                            <Border.Clip><RectangleGeometry Rect="0,0,52,74" RadiusX="8" RadiusY="8"/></Border.Clip>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,1,0,0">
                                            <Run Text="{Binding GenreText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PriceText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" FontSize="13" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="View" VerticalAlignment="Center" Tag="{Binding Link}" Click="Suggest_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0"
                           Text="A hand-picked list that works offline. Pulse only looks at which games are installed; it doesn't track what you play. View opens the store page in your browser."/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ One game ═════════ -->
        <Grid x:Name="DetailView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- Fixed bar: always visible, however far down you scroll. Esc or the mouse's back button also go back. -->
            <Grid Margin="0,0,0,10">
                <Button x:Name="BackBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Back_Click" Padding="14,8" ToolTip="Back to all games (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12"/>
                        <TextBlock Text="All games" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveGameBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Remove from my games" Click="RemoveGame_Click" Visibility="Collapsed"/>
            </Grid>
        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PlanPanel" Margin="0,0,0,36">
                <!-- Banner -->
                <Border CornerRadius="12" Margin="0,0,0,16" Height="128" ClipToBounds="True" x:Name="Banner">
                    <Grid>
                        <Image x:Name="BannerBlur" Stretch="UniformToFill" Opacity="0.6" Margin="-40">
                            <Image.Effect><BlurEffect Radius="40"/></Image.Effect>
                        </Image>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E60B0C10" Offset="0"/>
                                    <GradientStop Color="#400B0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="16" ClipToBounds="True" x:Name="BannerIconBox">
                                <Grid>
                                    <Image x:Name="BannerIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="BannerLetters" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="GameTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="GameStatus" FontSize="13" Foreground="#CCFFFFFF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                    <!-- One click: write the pro settings into the game's own settings file -->
                    <Border x:Name="AutoCard" CornerRadius="12" Padding="22,18" Margin="0,0,0,16" BorderThickness="1" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1FF2EFE8" Offset="0"/>
                                <GradientStop Color="#1FF2EFE8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#66F2EFE8" Offset="0"/>
                                <GradientStop Color="#66F2EFE8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AutoTitle" Style="{StaticResource CardTitle}" Text="Apply the pro settings for me"/>
                                <TextBlock x:Name="AutoText" Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="AutoUndoBtn" Style="{StaticResource GhostButton}" Content="Undo" Margin="0,0,10,0" Click="AutoUndo_Click" Visibility="Collapsed"/>
                                <Button x:Name="AutoBtn" Style="{StaticResource PrimaryButton}" Click="Auto_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="13"/>
                                        <TextBlock x:Name="AutoBtnText" Text="Apply" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="24,20">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Lower your delay" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <Border x:Name="ReflexPill" Style="{StaticResource Pill}" Background="{StaticResource GoodSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="NVIDIA Reflex" Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                                <Border x:Name="AntiLagPill" Style="{StaticResource Pill}" Background="{StaticResource BadSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="AMD Anti-Lag 2" Foreground="{StaticResource BadBrush}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="PlanIntro" Style="{StaticResource Body}"/>
                            <Grid Margin="0,14,0,0">
                                <Border Style="{StaticResource BarTrack}"/>
                                <Border x:Name="PlanBar" Style="{StaticResource BarFill}"/>
                            </Grid>

                            <ItemsControl x:Name="StepList" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The whole step is clickable, not just the circle -->
                                        <Border x:Name="Row" Margin="-12,0,-12,6" Padding="12,10" CornerRadius="10" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="StepRow_Click" ui:Anim.Reveal="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Done, Mode=TwoWay}" IsEnabled="{Binding CanTick}" IsHitTestVisible="False" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1" Opacity="{Binding Done, Converter={StaticResource BoolToOpacity}, ConverterParameter=invert}">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                                                            Click="StepAction_Click" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0AFFFFFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding CanTick}" Value="False">
                                                <Setter TargetName="Row" Property="Cursor" Value="Arrow"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                       Text="Menu names can move when a game updates. If a setting isn't where Pulse says, look in the game's Video or Graphics settings."/>
                        </StackPanel>
                    </Border>

                    <!-- Delay check -->
                    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Check this game's delay"/>
                                    <TextBlock x:Name="CheckIntro" Style="{StaticResource Body}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button x:Name="CheckBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Check_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="13"/>
                                        <TextBlock x:Name="CheckBtnText" Text="Check delay" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CheckRunning" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid Width="48" Height="48" Margin="0,0,14,0">
                                    <ui:Ring x:Name="CheckRing" Thickness="5" Brush="{StaticResource AccentGradient}"/>
                                    <TextBlock x:Name="CheckCount" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CheckStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <UniformGrid x:Name="ResultGrid" Columns="3" Margin="0,18,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Delay"/>
                                    <TextBlock x:Name="DelayValue" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="DelayKind" Style="{StaticResource Body}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Average FPS"/>
                                    <TextBlock x:Name="FpsValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="1% low FPS"/>
                                    <TextBlock x:Name="LowValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CompareText" Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- ═════════ Add a game ═════════ -->
        <Grid x:Name="Picker" Visibility="Collapsed" Background="#B30B0C10" Margin="-36,-6,-36,0">
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="620" Padding="24,20" Background="{StaticResource Surface2Brush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Add a game"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,14"
                                   Text="Games Pulse found on this PC. Added games get the general low-delay checklist and the delay check, under their own name."/>
                        <TextBox x:Name="PickerSearch" Style="{StaticResource SearchBox}" Tag="Search your games" TextChanged="PickerSearch_Changed" Margin="0,0,0,10"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="PickerLoading" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8">
                            <ui:Spinner Width="18" Height="18" Brush="{StaticResource AccentGradient}"/>
                            <TextBlock Text="Looking for games…" Margin="10,0,0,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="PickerEmpty" Style="{StaticResource Body}" Visibility="Collapsed" Margin="0,8"
                                   Text="No other Steam or Epic games found. Use Browse to pick the game's .exe yourself."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PickerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="10,8" Margin="0,0,0,4" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="PickerRow_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34" Margin="0,0,12,0">
                                                    <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Where}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Add" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="PickerBrowse_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" FontSize="13"/>
                                <TextBlock Text="Browse for a game's .exe" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="Cancel" Click="PickerClose_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
