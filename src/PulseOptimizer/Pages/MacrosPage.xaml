<UserControl x:Class="Pulse.Pages.MacrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui"
             Focusable="True">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,40">
            <TextBlock Style="{StaticResource H1}" Text="Macros"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Auto and butterfly clicking, key sequences on any key or mouse button, and Logitech G Hub scripts on any mouse. For accessibility, repetitive tasks and games that allow macros. Don't use them for an unfair advantage: many games and servers ban macros, and that's on whoever uses them."/>

            <!-- On / off, and what's happening -->
            <Border Style="{StaticResource HeroCard}" Margin="0,22,0,0" Padding="24,20" ui:Anim.Reveal="True">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" Margin="10,0,0,0" Text="Macros off"/>
                        </StackPanel>
                        <TextBlock x:Name="StateText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BlockText" Foreground="{StaticResource WarnBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="ShooterText" Foreground="{StaticResource InfoBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,22,0">
                                <TextBlock x:Name="RunningCount" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Right" Text="0"/>
                                <TextBlock Text="running" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="LiveCps" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Right" Text="0"/>
                                <TextBlock Text="clicks per second" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="ArmBtn" Style="{StaticResource PrimaryButton}" Content="Turn on" Margin="0,12,0,0" MinWidth="170" HorizontalAlignment="Right" Click="Arm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- The list -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Your macros"/>
                        <ListBox x:Name="MacroPick" Style="{StaticResource PickList}" Margin="0,12,0,0" SelectionChanged="Pick_Changed"/>
                        <TextBlock Style="{StaticResource Label}" Text="NEW" Margin="0,10,0,6"/>
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Clicker" Margin="0,0,6,6" Click="NewClicker_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Key sequence" Margin="0,0,6,6" Click="NewSequence_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Logitech script" Margin="0,0,6,6" Click="NewScript_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Import .lua file" Margin="0,0,6,6" Click="ImportLua_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- The editor (filled in from code for the kind of macro) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" ui:Anim.Reveal="True">
                    <StackPanel x:Name="Editor"/>
                </Border>
            </Grid>

            <!-- Settings for all macros -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" ui:Anim.Reveal="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Settings"/>
                    <Grid Style="{StaticResource Row}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Stop key"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Text="Stops every macro at once and lets go of everything they're holding."/>
                        </StackPanel>
                        <ContentControl x:Name="PanicHost" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Show a notice when macros turn on or off"/>
                        <CheckBox x:Name="NotifySwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Option_Click"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Turn macros on when Pulse starts"/>
                        <CheckBox x:Name="AutoSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Option_Click"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Allow in games with anti-cheat"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Off: macros turn off while Riot Vanguard, Easy Anti-Cheat, BattlEye or FACEIT runs. Some of those games allow macros (League of Legends, Fortnite), others ban for them. Check your game's rules first: you take the risk."/>
                        </StackPanel>
                        <CheckBox x:Name="AntiCheatSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="AntiCheat_Click" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,20,0,0" MaxWidth="820" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Macros send input like any other input program: Pulse never touches a game's memory. They only react to your real keys and buttons, never to input from programs. Mouse-moving macros never run while a competitive shooter (VALORANT, CS2, Fortnite, Apex, Rainbow Six, Call of Duty and others) is open, because there it's aim help. Everywhere else, like Roblox farming, it's your call: we strongly advise against using macros where they're against the rules."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
