<UserControl x:Class="Pulse.Pages.MacrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui"
             Focusable="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,40">
            <TextBlock Style="{StaticResource H1}" Text="Click macro"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="780" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Clicks for you on a precise rhythm: steady, butterfly, jitter, or your own recorded clicking. For accessibility, testing and games that allow it. Don't use it for an unfair advantage: many games and servers ban macros."/>

            <!-- On / off, and what it's doing -->
            <Border Style="{StaticResource HeroCard}" Margin="0,22,0,0" Padding="24,20" ui:Anim.Reveal="True">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" Margin="10,0,0,0" Text="Macro off"/>
                        </StackPanel>
                        <TextBlock x:Name="StateText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BlockText" Foreground="{StaticResource WarnBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="LiveCps" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Right" Text="0"/>
                        <TextBlock Text="clicks per second" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                        <Button x:Name="ArmBtn" Style="{StaticResource PrimaryButton}" Content="Turn on" Margin="0,12,0,0" MinWidth="150" Click="Arm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- How it clicks -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" ui:Anim.Reveal="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="How it clicks"/>
                    <Grid Style="{StaticResource Row}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Pattern"/>
                        <WrapPanel x:Name="ModeChips" Grid.Column="1"/>
                    </Grid>
                    <TextBlock x:Name="ModeText" Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="170,0,0,6" TextWrapping="Wrap"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Speed"/>
                        <WrapPanel x:Name="CpsChips" Grid.Column="1"/>
                    </Grid>
                    <Grid x:Name="VariationRow" Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Timing"/>
                        <WrapPanel x:Name="VariationChips" Grid.Column="1"/>
                    </Grid>
                    <Grid x:Name="ScaleRow" Style="{StaticResource Row}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Play my rhythm at the speed above (instead of its own)"/>
                        <CheckBox x:Name="ScaleSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Button"/>
                        <WrapPanel x:Name="ButtonChips" Grid.Column="1"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Start it by"/>
                        <WrapPanel Grid.Column="1">
                            <WrapPanel x:Name="ActivationChips"/>
                            <Button x:Name="TriggerBtn" Style="{StaticResource GhostButton}" MinWidth="130" Margin="8,3,0,3" Click="Trigger_Click"
                                    PreviewKeyDown="Trigger_KeyDown" PreviewMouseDown="Trigger_MouseDown"/>
                        </WrapPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Only click in the game I'm playing (not in other windows)"/>
                        <CheckBox x:Name="OnlyGameSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Test pad -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" ui:Anim.Reveal="True">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Test pad"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                       Text="Click here yourself, or point at it and use the macro, to see the speed and rhythm. Record your own clicking to replay it exactly."/>
                        </StackPanel>
                        <Button x:Name="RecordBtn" Style="{StaticResource GhostButton}" Content="Record my rhythm (5 s)" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Record_Click"/>
                    </Grid>
                    <Border x:Name="Pad" Height="190" Margin="0,14,0,0" CornerRadius="14" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" MouseDown="Pad_MouseDown" MouseUp="Pad_MouseUp">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock x:Name="PadCps" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Text="0"/>
                                <TextBlock x:Name="PadText" FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Text="clicks per second"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Last 3 seconds" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,12,0,4"/>
                    <Canvas x:Name="Timeline" Height="44" ClipToBounds="True" Background="Transparent"/>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,32,0"><TextBlock Text="Best" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="PadBest" FontSize="18" FontWeight="SemiBold" Text="–"/></StackPanel>
                        <StackPanel Margin="0,0,32,0"><TextBlock Text="Steadiness" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="PadSteady" FontSize="18" FontWeight="SemiBold" Text="–"/></StackPanel>
                        <StackPanel Margin="0,0,32,0"><TextBlock Text="Rhythm saved" FontSize="12" Foreground="{StaticResource TextDimBrush}"/><TextBlock x:Name="PadRhythm" FontSize="18" FontWeight="SemiBold" Text="–"/></StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,20,0,0" MaxWidth="780" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Esc always stops the macro. It won't run while Riot Vanguard, Easy Anti-Cheat, BattlEye or FACEIT is running, because those can ban an account for macro clicks. Clicks are sent like any other input program's; Pulse never touches a game's memory."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
