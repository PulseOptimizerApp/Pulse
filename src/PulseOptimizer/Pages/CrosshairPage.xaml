<UserControl x:Class="Pulse.Pages.CrosshairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,8,40">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Crosshair"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Your own crosshair on top of any game. Paste your VALORANT crosshair code to use the exact same one everywhere."/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Show crosshair" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StateText" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Enabled_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="Columns" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftCol"/>
                <StackPanel x:Name="RightCol" Grid.Column="2"/>
            </Grid>

            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,18,0,0" MaxWidth="820" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="The crosshair is a see-through window that clicks pass through. Pulse never touches the game, the same way tools like Crosshair X work. It shows over games in borderless or windowed mode, not exclusive fullscreen. Some tournaments don't allow crosshair overlays, so check the rules before you compete."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
