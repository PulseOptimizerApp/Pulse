<UserControl x:Class="Pulse.Pages.FreshPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,36">
            <TextBlock Style="{StaticResource H1}" Text="Keep it fresh"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="PCs rarely slow down because of one thing. They drift: apps add themselves to startup, background processes pile up, and temp files fill the drive. Pulse saves a snapshot of your PC at its best, then shows you exactly what changed since."/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

                <!-- Status -->
                <Border Style="{StaticResource Card}" Padding="24,22" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="YOUR BASELINE"/>
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource H2}" Margin="0,8,0,0" Text="No snapshot yet"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Body}" Margin="0,6,0,0"
                                   Text="Save one now, ideally right after you've cleaned up and set Pulse's tweaks, while the PC feels fast. It takes about 30 seconds."/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="CheckBtn" Style="{StaticResource PrimaryButton}" Click="Check_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="13"/>
                                    <TextBlock x:Name="CheckBtnText" Text="Save snapshot" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RebaseBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Make this the new baseline" Click="Rebase_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:Name="Working" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <ui:Spinner Width="16" Height="16" Brush="{StaticResource AccentGradient}"/>
                            <TextBlock Text="Measuring startup apps, boot time, background processes and free space…" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Weekly tune-up -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20" ui:Anim.Reveal="True">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Weekly tune-up" VerticalAlignment="Center"/>
                            <CheckBox x:Name="WeeklySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Weekly_Click"/>
                        </Grid>
                        <TextBlock x:Name="WeeklyText" Style="{StaticResource Body}" FontSize="12.5" Margin="0,8,0,0"
                                   Text="Once a week at noon, Pulse quietly clears temporary files, Windows Update leftovers and crash dumps, then checks for drift. Nothing else changes on its own; you see the results here next time you open Pulse."/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11.5" Margin="0,8,0,0" Foreground="{StaticResource TextFaintBrush}"
                                   Text="Uses Windows Task Scheduler. Turn it off any time and the task is removed."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What changed -->
            <TextBlock x:Name="DriftHeader" Style="{StaticResource H2}" Text="What changed" Margin="0,28,0,12" Visibility="Collapsed"/>
            <ItemsControl x:Name="DriftList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,8" Padding="18,14" ui:Anim.Reveal="True">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding KindBrush}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12.5" Margin="0,3,0,0" Text="{Binding Detail}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="16,0,0,0" VerticalAlignment="Center" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                                        Click="Action_Click" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- History -->
            <TextBlock x:Name="HistoryHeader" Style="{StaticResource H2}" Text="Over time" Margin="0,24,0,12" Visibility="Collapsed"/>
            <Border x:Name="HistoryCard" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Startup}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Boot}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Procs}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Free}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
