<UserControl x:Class="Pulse.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <UserControl.Resources>
        <!-- Dashboard shortcut tile -->
        <Style x:Key="DashTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Without this the titles fall back to Windows' default black text, nearly invisible on the dark tiles. -->
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform x:Name="Lift"/></Grid.RenderTransform>
                            <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Glow" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AccentGradient}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,40">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Greeting" Style="{StaticResource H1}" Text="Home"/>
                    <TextBlock x:Name="PcLine" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}" Content="Measure FPS" Tag="measure" Click="Tile_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Tag="games" Click="Tile_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:LineIcon Kind="macros" Width="14.9" Height="14.9"/>
                            <TextBlock Text="Optimize a game" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Health + live -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- The hero: health, in the accent gradient so it's the first thing you see -->
                <Border CornerRadius="16" Padding="24,20" BorderThickness="1" ui:Anim.Reveal="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FF2EFE8" Offset="0"/>
                            <GradientStop Color="#1FF2EFE8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#66F2EFE8" Offset="0"/>
                            <GradientStop Color="#66F2EFE8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="PC HEALTH"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="124" Height="124" HorizontalAlignment="Left">
                                <ui:Ring x:Name="HealthRing" Thickness="10" Brush="{StaticResource AccentGradient}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HealthBig" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HealthSmall" Text="not checked" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="HealthTitle" Style="{StaticResource H2}" Text="Run a checkup" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HealthText" Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0"
                                           Text="About a minute. Pulse looks for real problems like a monitor stuck at 60 Hz or slow RAM."/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="IssueList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8" ui:Anim.Reveal="True">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"/>
                                        <!-- How much it matters, at a glance -->
                                        <TextBlock x:Name="Tag" Grid.Column="2" Text="Check" FontSize="11" FontWeight="SemiBold" Foreground="#FCD34D" Margin="12,1,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Problem">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource BadBrush}"/>
                                            <Setter TargetName="Tag" Property="Text" Value="Big win"/>
                                            <Setter TargetName="Tag" Property="Foreground" Value="#FCA5A5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="HealthBtn" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Health_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:LineIcon Kind="diagnose" Width="16.1" Height="16.1"/>
                                <TextBlock x:Name="HealthBtnText" Text="Run checkup" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" ui:Anim.Reveal="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource Label}" Text="LIVE"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Updating every second" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextDimBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CpuName" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ui:Sparkline x:Name="CpuSpark" Grid.Column="1" Height="34" Margin="8,0,12,0" Brush="{StaticResource Series1Brush}"/>
                                <TextBlock x:Name="CpuText" Grid.Column="2" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GPU" Foreground="{StaticResource TextDimBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GpuName" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ui:Sparkline x:Name="GpuSpark" Grid.Column="1" Height="34" Margin="8,0,12,0" Brush="{StaticResource Series2Brush}"/>
                                <TextBlock x:Name="GpuText" Grid.Column="2" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Memory" Foreground="{StaticResource TextDimBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RamName" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ui:Sparkline x:Name="RamSpark" Grid.Column="1" Height="34" Margin="8,0,12,0" Brush="{StaticResource Series3Brush}"/>
                                <TextBlock x:Name="RamText" Grid.Column="2" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="ClipsUse" FontSize="12" Foreground="{StaticResource TextDimBrush}" Text="Clips is off · it uses nothing until you turn it on"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Shortcuts -->
            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Button Style="{StaticResource DashTile}" Margin="0,0,12,0" Tag="cleanup" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1AF2EFE8" HorizontalAlignment="Left">
                            <ui:LineIcon Kind="cleanup" Width="19.5" Height="19.5" Foreground="#F2EFE8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Debloat" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="DeclutterStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="4,0,8,0" Tag="tweaks" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1FE0773F" HorizontalAlignment="Left">
                            <ui:LineIcon Kind="macros" Width="19.5" Height="19.5" Foreground="#E0773F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tweaks" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="TweakStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="8,0,4,0" Tag="clips" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1F8DB596" HorizontalAlignment="Left">
                            <ui:LineIcon Kind="clips" Width="19.5" Height="19.5" Foreground="#8DB596" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Clips" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ClipStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="Save your best moments with a hotkey"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="12,0,0,0" Tag="reaction" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#1A34D399" HorizontalAlignment="Left">
                            <ui:LineIcon Kind="reaction" Width="19.5" Height="19.5" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Reaction trainer" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="Train the reactions games use"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Games strip -->
            <Grid Margin="0,28,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H2}" Text="Your games"/>
                    <TextBlock x:Name="GameStat" FontSize="13" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Bottom" Margin="12,0,0,2" Text="Finding your games…"/>
                </StackPanel>
                <Button Style="{StaticResource LinkButton}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="games" Click="Tile_Click"/>
            </Grid>
            <ItemsControl x:Name="GameStrip">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GameTile}" Click="Game_Click" ui:Anim.Reveal="True"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="GamesLoading" Orientation="Horizontal">
                <ui:Spinner Width="18" Height="18" Brush="{StaticResource AccentGradient}"/>
                <TextBlock Text="Finding your games…" Margin="10,0,0,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
