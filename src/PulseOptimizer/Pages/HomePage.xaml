<UserControl x:Class="Pulse.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <UserControl.Resources>
        <!-- Dashboard shortcut tile -->
        <Style x:Key="DashTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform x:Name="Lift"/></Grid.RenderTransform>
                            <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,16">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Glow" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AccentGradient}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,36">
            <TextBlock x:Name="Greeting" Style="{StaticResource H1}" Text="Home"/>
            <TextBlock x:Name="PcLine" Style="{StaticResource Sub}" Margin="0,4,0,0"/>

            <!-- Health + live -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="22,20" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="PC HEALTH"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96" HorizontalAlignment="Left">
                                <ui:Ring x:Name="HealthRing" Thickness="8" Brush="{StaticResource AccentGradient}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HealthBig" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HealthSmall" Text="not checked" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock x:Name="HealthTitle" Style="{StaticResource CardTitle}" Text="Run a checkup"/>
                                <TextBlock x:Name="HealthText" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,0"
                                           Text="About a minute. Pulse looks for real problems like a monitor stuck at 60 Hz or slow RAM."/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="IssueList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8" ui:Anim.Reveal="True">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Problem"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource BadBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="HealthBtn" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Health_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="14"/>
                                <TextBlock x:Name="HealthBtnText" Text="Run checkup" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20" ui:Anim.Reveal="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource Label}" Text="LIVE"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Updating every second" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="CPU" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                <TextBlock x:Name="CpuText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <ui:Sparkline x:Name="CpuSpark" Height="54" Margin="0,8,0,0" Brush="#22D3EE"/>
                                <TextBlock x:Name="CpuName" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,8,0">
                                <TextBlock Text="GPU" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                <TextBlock x:Name="GpuText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <ui:Sparkline x:Name="GpuSpark" Height="54" Margin="0,8,0,0" Brush="#5B8CFF"/>
                                <TextBlock x:Name="GpuName" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Memory" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                <TextBlock x:Name="RamText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <ui:Sparkline x:Name="RamSpark" Height="54" Margin="0,8,0,0" Brush="#8B5CF6"/>
                                <TextBlock x:Name="RamName" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Shortcuts -->
            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Button Style="{StaticResource DashTile}" Margin="0,0,12,0" Tag="cleanup" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Debloat" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="DeclutterStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="4,0,8,0" Tag="tweaks" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tweaks" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="TweakStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="8,0,4,0" Tag="games" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Games" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="GameStat" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" Text="Finding your games…"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashTile}" Margin="12,0,0,0" Tag="security" Click="Tile_Click" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Security" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" Text="Malware and startup check"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Games strip -->
            <Grid Margin="0,28,0,14">
                <TextBlock Style="{StaticResource H2}" Text="Your games"/>
                <Button Style="{StaticResource LinkButton}" Content="See all" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="games" Click="Tile_Click"/>
            </Grid>
            <ItemsControl x:Name="GameStrip">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GameTile}" Click="Game_Click" ui:Anim.Reveal="True"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="GamesLoading" Orientation="Horizontal">
                <ui:Spinner Width="18" Height="18" Brush="{StaticResource AccentGradient}"/>
                <TextBlock Text="Finding your games…" Margin="10,0,0,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
