<UserControl x:Class="Pulse.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Startup, updates and language."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Root" Margin="0,0,8,32" MaxWidth="900" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
