<UserControl x:Class="Pulse.Pages.ClipsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <UserControl.Resources>
        <Style x:Key="TrackToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Border x:Name="On" CornerRadius="16" Background="{StaticResource AccentGradient}" Opacity="0"/>
                            <ContentPresenter Margin="14,6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="On" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,6,0,40">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H1}" Text="Clips"/>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource InfoSoftBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PillText}" Text="Beta" Foreground="{StaticResource InfoBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                           Text="Instant replay that doesn't slow your game down. Press a key and the last minute is saved."/>

                <!-- ═════════ The pitch (Clips off) ═════════ -->
                <Border x:Name="PitchCard" CornerRadius="16" Padding="30,26" Margin="0,22,0,0" BorderThickness="1" ui:Anim.Reveal="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2622D3EE" Offset="0"/>
                            <GradientStop Color="#268B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7722D3EE" Offset="0"/>
                            <GradientStop Color="#778B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock Text="Never miss the play again." FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left" FontSize="14"
                                   Text="Pulse keeps the last moments of your game ready. One key saves them as a clip, in full quality, without the ads, accounts and background apps other clippers bring."/>
                        <UniformGrid Columns="2" Margin="0,22,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,0" Text="Your graphics card does the work"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,3,0,0" Text="Recording uses the video chip built into your graphics card (NVIDIA, AMD or Intel), not the part that runs your game. Pulse shows exactly what it uses."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,8" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,0" Text="Easy on your SSD"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,3,0,0" Text="The replay waits in memory. Only the clips you save are written to your drive, so nothing writes to your SSD nonstop."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,8,8,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,0" Text="No account, no ads, no feed"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,3,0,0" Text="Clips stay on your PC in one folder. Pulse only runs the replay while a game is open, and it's fully off the rest of the time."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,8,0,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,0" Text="Trim it, send it"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,3,0,0" Text="Cut to the moment, then make a copy that fits a free Discord upload in one click."/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button x:Name="EnableBtn" Style="{StaticResource PrimaryButton}" Padding="26,12" Click="Enable_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="14"/>
                                    <TextBlock Text="Turn on Clips" Margin="10,0,0,0" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="440" TextWrapping="Wrap"
                                       Text="Pulse downloads FFmpeg, the open-source video engine, once (about 65 MB) from its own GitHub release and checks it before use. That's the only time Clips goes online."/>
                        </StackPanel>
                        <!-- Download progress -->
                        <StackPanel x:Name="SetupPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <Grid>
                                <Border Style="{StaticResource BarTrack}" Height="6"/>
                                <Border x:Name="SetupBar" Style="{StaticResource BarFill}" Height="6" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="SetupText" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═════════ Status (Clips on) ═════════ -->
                <Border x:Name="StatusCard" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,20" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitle" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Body}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                    <TextBlock x:Name="HotkeyBig" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="UsageText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <Border x:Name="CostBox" Visibility="Collapsed" Margin="0,14,0,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <TextBlock x:Name="CostText" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button x:Name="SaveNowBtn" Style="{StaticResource PrimaryButton}" Click="SaveNow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource IconText}" FontSize="13"/>
                                    <TextBlock Text="Save clip now" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SessionNowBtn" Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="SessionNow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="{StaticResource BadBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SessionNowText" Text="Start recording" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CostBtn" Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Content="Test what Clips costs" Click="Cost_Click"
                                    ToolTip="Measures your game's FPS with Clips off and on (about 2 minutes, keep playing)"/>
                            <Button Style="{StaticResource LinkButton}" Content="Turn Clips off" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Disable_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═════════ Settings ═════════ -->
                <Border x:Name="SettingsCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource H2}" Text="Settings"/>
                            <ToggleButton x:Name="MoreToggle" Style="{StaticResource LinkToggle}" Content="More settings" HorizontalAlignment="Right" Click="More_Click"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Replay length"/>
                            <WrapPanel x:Name="LengthChips" Grid.Column="1"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Quality"/>
                            <StackPanel Grid.Column="1">
                                <WrapPanel x:Name="QualityChips"/>
                                <TextBlock x:Name="QualityText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Game sound"/>
                            <WrapPanel x:Name="GameVolChips" Grid.Column="1"/>
                            <CheckBox x:Name="GameAudioSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Microphone"/>
                            <WrapPanel x:Name="MicVolChips" Grid.Column="1"/>
                            <CheckBox x:Name="MicSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Save hotkey"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="HotkeyBtn" Style="{StaticResource GhostButton}" MinWidth="140" Tag="main" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown"/>
                                <TextBlock x:Name="HotkeyWarn" Foreground="{StaticResource WarnBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Quick clip hotkey"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="QuickBtn" Style="{StaticResource GhostButton}" MinWidth="140" Tag="quick" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown"/>
                                <WrapPanel x:Name="QuickLenChips" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="QuickSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Screenshot hotkey"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ShotBtn" Style="{StaticResource GhostButton}" MinWidth="140" Tag="shot" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown"/>
                                <TextBlock x:Name="ExtraWarn" Foreground="{StaticResource WarnBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                            <CheckBox x:Name="ShotSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Record a session"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SessionBtn" Style="{StaticResource GhostButton}" MinWidth="140" Tag="session" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"
                                           Text="Press once to start recording everything, again to stop. Saved straight to disk, so it can run for hours."/>
                            </StackPanel>
                            <CheckBox x:Name="SessionSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Bookmark hotkey"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="MarkBtn" Style="{StaticResource GhostButton}" MinWidth="140" Tag="mark" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"
                                           Text="Marks a moment. Clips and recordings that include it show a marker you can jump to."/>
                            </StackPanel>
                            <CheckBox x:Name="MarkSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Setting_Click"/>
                        </Grid>

                        <!-- More settings -->
                        <StackPanel x:Name="MorePanel" Visibility="Collapsed">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Resolution"/>
                                <WrapPanel x:Name="ResChips" Grid.Column="1"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Frame rate"/>
                                <WrapPanel x:Name="FpsChips" Grid.Column="1"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Bitrate"/>
                                <WrapPanel x:Name="BitrateChips" Grid.Column="1"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Video format"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel x:Name="CodecChips"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                               Text="H.264 plays everywhere. HEVC and AV1 look better at the same size, but some phones and older PCs can't play them."/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Record"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel x:Name="CaptureChips"/>
                                    <TextBlock x:Name="CaptureHint" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                               Text="Records only the game's window, on whichever screen it's on. Discord and other windows on top stay out of your clips. If a game can't be recorded this way, Pulse records the whole screen instead."/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Display"/>
                                <WrapPanel x:Name="MonitorChips" Grid.Column="1"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Storage limit"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel x:Name="LimitChips"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" Text="When the folder grows past this, the oldest clips go first. Favorites are never deleted."/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Clips folder"/>
                                <TextBlock x:Name="FolderText" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Change" Click="Folder_Click"/>
                            </Grid>

                            <TextBlock Style="{StaticResource CardTitle}" Text="Behaviour" Margin="0,8,0,10"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Only keep a replay while a game is running (uses nothing the rest of the time)"/>
                                <CheckBox x:Name="OnlyGamingSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Keep clipping when the Pulse window is closed (Pulse waits by the clock)"/>
                                <CheckBox x:Name="TraySwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows, so clips work without opening Pulse"/>
                                <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Startup_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Also save game sound and microphone on their own tracks, so either can be muted when trimming"/>
                                <CheckBox x:Name="SeparateMicSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid x:Name="AppTracksRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Give the game, Discord and Spotify their own tracks, so you can mute any of them in a clip"/>
                                <CheckBox x:Name="AppTracksSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Record the mouse cursor"/>
                                <CheckBox x:Name="CursorSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Play a sound when a clip is saved"/>
                                <CheckBox x:Name="SoundSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show a small &quot;Clip saved&quot; popup"/>
                                <CheckBox x:Name="PopupSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="Setting_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═════════ Library ═════════ -->
                <Grid x:Name="LibraryHeader" Margin="0,28,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H2}" Text="Your clips"/>
                        <TextBlock x:Name="LibrarySummary" Foreground="{StaticResource TextDimBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DeleteSelectedBtn" Style="{StaticResource GhostButton}" Visibility="Collapsed" Margin="0,0,10,0" Click="DeleteSelected_Click"/>
                        <ToggleButton x:Name="SelectToggle" Style="{StaticResource LinkToggle}" Content="Select" Margin="0,0,16,0" VerticalAlignment="Center" Click="Select_Click"/>
                        <Button Style="{StaticResource LinkButton}" Content="Open folder" VerticalAlignment="Center" Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>
                <!-- Find clips: search, game, favorites, order -->
                <Grid x:Name="LibraryTools" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ClipSearch" Style="{StaticResource SearchBox}" Tag="Search clips" TextChanged="ClipFilter_Changed" VerticalAlignment="Top"/>
                    <WrapPanel x:Name="GameFilterChips" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <WrapPanel x:Name="SortChips" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="LibraryNoMatch" Style="{StaticResource Body}" Visibility="Collapsed" Text="No clips match."/>
                <TextBlock x:Name="LibraryEmpty" Style="{StaticResource Body}" Visibility="Collapsed"
                           Text="No clips yet. Start a game and press the hotkey after a good moment."/>
                <ItemsControl x:Name="ClipGrid" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Width="250" Margin="0,0,14,14" Padding="0" ClipToBounds="True" Cursor="Hand"
                                    MouseLeftButtonUp="Clip_Click" Tag="{Binding}" ui:Anim.Reveal="True">
                                <StackPanel>
                                    <Grid Height="140" Background="#0B0C10">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="28" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="22" Height="22" CornerRadius="11" BorderThickness="2" BorderBrush="White"
                                                Background="{Binding CheckBrush}" Visibility="{Binding SelectVisibility}">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="#0B0C10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CheckVisibility}"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="6" Padding="6,2" Background="#CC0B0C10"
                                                Visibility="{Binding Clip.Favorite, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE735;" Style="{StaticResource IconText}" FontSize="11" Foreground="#FBBF24"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="14,10,14,12">
                                        <TextBlock Text="{Binding Clip.Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,20,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Text="Clips records with FFmpeg (ffmpeg.org, GPL), downloaded on demand and run as a separate program. Recording uses Windows' own screen capture, so it never touches a game and anti-cheat has nothing to flag."/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ Player ═════════ -->
        <Grid x:Name="PlayerLayer" Visibility="Collapsed" Background="#E6080A0F">
            <Border Style="{StaticResource Card}" Background="{StaticResource Surface2Brush}" Margin="0,10,0,10" MaxWidth="1000" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="PlayerTitle" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                        <TextBox x:Name="RenameBox" Style="{StaticResource SearchBox}" Visibility="Collapsed" Margin="0,0,120,0" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                        <Button Style="{StaticResource GhostButton}" Content="Close" HorizontalAlignment="Right" Click="PlayerClose_Click"/>
                    </Grid>
                    <Border x:Name="VideoBox" Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                                      MediaOpened="Player_Opened" MediaEnded="Player_Ended" MouseLeftButtonUp="PlayPause_Click" MouseLeftButtonDown="Video_MouseDown"/>
                    </Border>
                    <!-- Timeline: drag the gradient handles to trim, drag anywhere else to scrub -->
                    <ui:ClipTimeline x:Name="Timeline" Grid.Row="2" Margin="0,14,0,0"/>
                    <Grid x:Name="PlayerControls" Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PlayBtn" Style="{StaticResource GhostButton}" Width="44" Padding="0,8" Click="PlayPause_Click" ToolTip="Play or pause (Space)">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE769;" Style="{StaticResource IconText}" FontSize="13"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeText" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                            <TextBlock x:Name="SelText" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Sound to keep in the exported copy -->
                        <StackPanel x:Name="AudioPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE767;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0"/>
                            <WrapPanel x:Name="TrackToggles" ToolTip="Sound to keep in the saved and Discord copies"/>
                        </StackPanel>
                        <Button x:Name="FullBtn" Grid.Column="4" Style="{StaticResource GhostButton}" Width="44" Padding="0,8" Margin="12,0,0,0" Click="Full_Click" ToolTip="Full screen (F)">
                            <TextBlock x:Name="FullGlyph" Text="&#xE740;" Style="{StaticResource IconText}" FontSize="13"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FavBtn" Style="{StaticResource GhostButton}" Click="Fav_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Rename" Click="Rename_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Show in folder" Click="Reveal_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Delete" Click="Delete_Click" ToolTip="Delete (Del)"/>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="Space play · ← → step · Shift ← → 1 s · I / O set start and end · F full screen"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Save trimmed copy" Click="Trim_Click" Margin="0,0,8,0"/>
                            <Button x:Name="DiscordBtn" Style="{StaticResource PrimaryButton}" Click="Discord_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72D;" Style="{StaticResource IconText}" FontSize="13"/>
                                    <TextBlock Text="Discord copy (under 10 MB)" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
