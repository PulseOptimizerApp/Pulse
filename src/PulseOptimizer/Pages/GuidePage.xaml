<UserControl x:Class="Pulse.Pages.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- Header: title, how fresh the guide is, and the tabs on a hairline -->
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="PC guide"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Tips, prices and picks, each one linked to where it came from."/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="999" Padding="11,5" Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="FreshDot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FreshText" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,18,0,0">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush}"/>
                <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
            </Grid>
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="0,0,8,32"/>
        </ScrollViewer>
    </Grid>
</UserControl>
