<UserControl x:Class="Pulse.Pages.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <!-- Header: a soft gradient banner with the title, how fresh the guide is, and the section tabs -->
            <Border CornerRadius="14" Padding="26,22,26,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2622D3EE" Offset="0"/>
                        <GradientStop Color="#1A5B8CFF" Offset="0.45"/>
                        <GradientStop Color="#228B5CF6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="PC guide"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Text="What makes games run smoother, what hardware costs right now, and the gear and prebuilt PCs reviewers rate best. Every pick links to its source; nobody pays Pulse to be here."/>
                        </StackPanel>
                        <Border x:Name="FreshPill" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="999" Padding="10,4" Background="#22000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock x:Name="FreshText" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                        </Border>
                    </Grid>
                    <WrapPanel x:Name="Tabs" Margin="0,18,0,-8"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="0,0,6,32"/>
        </ScrollViewer>
    </Grid>
</UserControl>
