<UserControl x:Class="Pulse.Pages.SafetyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,32">
            <TextBlock Style="{StaticResource H1}" Text="Undo &amp; restore"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="740" HorizontalAlignment="Left"
                       Text="Pulse saves the exact previous value of everything it changes, so any tweak can be put back precisely. For extra safety it can also create a Windows restore point, which rolls back the whole system."/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Windows restore point"/>
                        <TextBlock x:Name="RestoreInfo" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="CreateRpBtn" Style="{StaticResource PrimaryButton}" Content="Create one now" Click="CreateRp_Click"/>
                            <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Open System Restore" Click="OpenRestore_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" ui:Anim.Reveal="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Automatic safety net"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Text="Create a restore point before the first change in each session. Recommended — it takes up to a minute, once."/>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Open Pulse's backup folder" Click="OpenData_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoRp" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="16,2,0,0" Click="AutoRp_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,28,0,12">
                <TextBlock Style="{StaticResource H2}" Text="Tweaks Pulse has applied" VerticalAlignment="Center"/>
                <Button x:Name="UndoAllBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="Undo everything" Click="UndoAll_Click"/>
            </Grid>
            <TextBlock x:Name="NoneApplied" Style="{StaticResource Body}" Text="Nothing applied yet."/>
            <ItemsControl x:Name="AppliedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,8" Padding="18,12" ui:Anim.Reveal="True">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"/>
                                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0" Text="{Binding Changes}"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Undo" Click="Undo_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource H2}" Text="Activity" Margin="0,28,0,12"/>
            <Border Style="{StaticResource Card}" Padding="18,12">
                <ItemsControl x:Name="LogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextFaintBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
