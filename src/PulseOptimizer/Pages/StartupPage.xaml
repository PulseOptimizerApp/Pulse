<UserControl x:Class="Pulse.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Startup apps"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Programs that launch when you sign in, using memory and CPU in the background while you play. Turning one off doesn't uninstall it. It just stops it starting automatically. It's the same switch as Task Manager's Startup tab, so both always agree."/>
            <TextBlock x:Name="CountText" Style="{StaticResource Body}" Margin="0,22,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Spinner Width="22" Height="22" Brush="{StaticResource AccentGradient}"/>
                <TextBlock Text="Reading startup programs…" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AppList" Margin="0,0,0,32">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,10" ui:Anim.Reveal="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <Border CornerRadius="10" Background="#14FFFFFF"/>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource IconText}" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Opacity="{Binding Enabled, Converter={StaticResource BoolToOpacity}}">
                                        <WrapPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,10,4" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Pill}" Background="{Binding AdviceBackground}" Margin="0,0,6,4">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding AdviceLabel}" Foreground="{Binding AdviceBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Body}" Text="{Binding Advice}"/>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextFaintBrush}">
                                            <Run Text="{Binding PublisherText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Text="{Binding Command}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Show file location" Click="Locate_Click"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Margin="20,2,0,0" VerticalAlignment="Top" Width="46">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Switch_Click"
                                                  Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
                                        <ui:Spinner Width="24" Height="24" Brush="{StaticResource AccentGradient}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
